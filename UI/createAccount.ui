    <property name="styleSheet">
     <string notr="true">QPushButton {
    background-color: #2e7d32;        /* Green */
    color: white;
    border: none;
    border-radius: 12px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #43a047;
    box-shadow: 0px 0px 10px rgba(67, 160, 71, 180);
}

QPushButton:pressed {
    background-color: #1b5e20;
}
</string>
    </property>
